{
  "name": "paperquest",
  "version": "1.0.0",
  "private": true,
  "description": "Upload papers, get a prerequisite skill tree from high-school math/physics up to the paper, and learn it like a game.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"node server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test \"server/**/*.test.js\"",
    "graph:knowledge": "node scripts/export-knowledge-graph.js",
    "workspace:export": "node scripts/export-workspace.js",
    "workspace:stage-developer": "node scripts/stage-developer-backup.js"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.1",
    "@vercel/functions": "^3.9.9",
    "3d-force-graph": "^1.80.0",
    "express": "^4.19.2",
    "google-auth-library": "^11.1.0",
    "katex": "^0.16.10",
    "multer": "^1.4.5-lts.1",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "rehype-katex": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "serverless-http": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.0",
    "vite": "^5.4.0"
  }
}
